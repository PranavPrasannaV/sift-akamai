[Unit]
Description=Sift recall pull sheets on Akamai Cloud
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/sift
EnvironmentFile=/root/sift/.env
ExecStart=/root/sift/.venv/bin/python -m pullsheet.main --host 0.0.0.0 --port 80
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
